
@article{fioranelli_performance_2016,
	title = {Performance {Analysis} of {Centroid} and {SVD} {Features} for {Personnel} {Recognition} {Using} {Multistatic} {Micro}-{Doppler}},
	volume = {13},
	issn = {1558-0571},
	url = {https://ieeexplore.ieee.org/abstract/document/7444151?casa_token=sG7yAXRbbLEAAAAA:6Iiok_rqGHUX-IUweNR_Mnb0Vw42S1X-e7CmwKM_c0XaySL-VBjKv87DyhfllbmK7Qp4NsY},
	doi = {10.1109/LGRS.2016.2539386},
	abstract = {In this letter, we investigate the use of micro-Doppler signatures experimentally recorded by a multistatic radar system to perform recognition of people walking. Three different sets of features are tested, taking into account the impact on the overall classification performance of parameters, such as aspect angle, types of classifier, different values of signal-to-noise ratio, and different ways of exploiting multistatic information. High classification accuracy of above 98\% is reported for the most favorable aspect angle, and the benefit of using multistatic data at less favorable angles is discussed.},
	number = {5},
	urldate = {2025-02-12},
	journal = {IEEE Geoscience and Remote Sensing Letters},
	author = {Fioranelli, Francesco and Ritchie, Matthew and Griffiths, Hugh},
	month = may,
	year = {2016},
	note = {Conference Name: IEEE Geoscience and Remote Sensing Letters},
	keywords = {Doppler effect, Feature extraction, Legged locomotion, micro-Doppler, multistatic radar, Multistatic radar, Personnel, Spectrogram, target classification},
	pages = {725--729},
	file = {Accepted Version:/Users/jadeg/Zotero/storage/BCZAGFJJ/Fioranelli et al. - 2016 - Performance Analysis of Centroid and SVD Features .pdf:application/pdf;IEEE Xplore Abstract Record:/Users/jadeg/Zotero/storage/2EKGWYST/7444151.html:text/html},
}

